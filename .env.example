POSTGRES_USER=wallet
# Required, must be URL-safe. Generate with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=finance
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
REDIS_URL=redis://127.0.0.1:6379/0
# Login fails open when Redis does not answer within this time
REDIS_TIMEOUT_SECONDS=1.0
EXCHANGE_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1
# Rates of past days for analytics: {day} becomes a date such as 2025-03-14
EXCHANGE_API_HISTORY_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@{day}/v1
# The first day the API has rates for: operations of earlier days get its rates
EXCHANGE_API_HISTORY_START=2024-03-02
EXCHANGE_API_TIMEOUT_SECONDS=5.0
# Requests to the exchange API at once from one process
EXCHANGE_API_MAX_CONCURRENCY=10
# Lock that lets one process load the rates of a day while the others wait
EXCHANGE_RATE_LOCK_SECONDS=30
# How long a request waits for another process before it loads the day itself
EXCHANGE_RATE_WAIT_SECONDS=10.0
# Required, at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# How long /health/ready waits for the database
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Login attempts per window: from one IP, and for one login from one IP
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_LOGIN=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Text input requests per window from one user: every request is a paid model call
PARSE_RATE_LIMIT_PER_USER=10
PARSE_RATE_LIMIT_WINDOW_SECONDS=60
# Required. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# How long one model request may take: categorization in the worker, text input in the API
OPENAI_TIMEOUT_SECONDS=30.0
# Longest range of an analytics report, in days: ten years
ANALYTICS_MAX_RANGE_DAYS=3653
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# text for local development, json for servers where logs are collected
LOG_FORMAT=text
