POSTGRES_USER=wallet
# Required, must be URL-safe. Generate with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=finance
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
REDIS_URL=redis://127.0.0.1:6379/0
# Login fails open when Redis does not answer within this time
REDIS_TIMEOUT_SECONDS=1.0
EXCHANGE_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1
EXCHANGE_API_TIMEOUT_SECONDS=5.0
# Required, at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# How long /health/ready waits for the database
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Login attempts per window: from one IP, and for one login from one IP
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_LOGIN=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# text for local development, json for servers where logs are collected
LOG_FORMAT=text
