POSTGRES_USER=wallet
# Required, must be URL-safe. Generate with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=finance
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
EXCHANGE_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1
EXCHANGE_API_TIMEOUT_SECONDS=5.0
# Required, at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
